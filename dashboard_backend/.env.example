# App
APP_NAME="Enterprise Analytics Platform - Dashboard Backend"
APP_ENV="development"
LOG_LEVEL="INFO"

# CORS
# Comma-separated list of allowed origins. Use "*" only in dev.
CORS_ALLOW_ORIGINS="http://localhost:3000"

# Security / Auth
# Generate a strong random secret for production.
JWT_SECRET="change-me"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Postgres connection (preferred: full URL)
# NOTE: The platform also provisions these individually for the database container.
POSTGRES_URL="postgresql+asyncpg://appuser:dbuser123@localhost:5000/myapp"

# Optional: tenant resolution mode
# header = use X-Organization-Id / X-Workspace-Id headers
# token  = use org/workspace claims from JWT
TENANCY_MODE="header"
